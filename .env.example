# Prefer the browser model settings after npm start.
# Optional legacy Jev settings below; browser-saved settings take precedence.
# Run npm run setup to configure Jev from the terminal.
# Choices: typesafe | vercel | openrouter. No URL or model setting needed.
JEV_PROVIDER=typesafe
JEV_API_KEY=
PORT=3178
HOST=127.0.0.1

# ---- 微信记录导入（可选，不入库的个人信息写在这里）----
# 解密后的 db_storage 目录（chatlog 产物），默认假设在本仓库 wechat-decrypted2/db_storage
# WX_DB_ROOT=D:/your/path/wechat-decrypted2/db_storage
# 你自己的微信 wxid，用于把消息标成「我」；不配置则不标记
# WX_SELF_ID=wxid_xxxxxxxxxxxx
